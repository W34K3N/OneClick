<?xml version="1.0" encoding="utf-8"?>
<!--
  Конфиг приложения OneClick.

  Зачем нужен: без него .NET Framework работает в режиме legacy path handling,
  и путь с префиксом "\\?\" (см. Util.LongPath) считается недопустимым —
  File.Copy падает с ArgumentException "Путь содержит недопустимые знаки",
  а ошибка глотается в catch. В результате длинные пути (>= 200 символов)
  молча не копировались (например, профиль Zen Browser).

  С этим файлом .NET сам включает длинные пути иначе и префикс "\\?\" работает.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" />
  </runtime>
</configuration>
